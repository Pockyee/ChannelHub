# ChannelHub 本地开发环境变量模板
# 复制为 .env 并填入真实值；密码建议用 openssl 随机生成：
#   openssl rand -hex 24
# 真实的 .env 已被 .gitignore 排除，请勿提交。

# ---- 环境标识 ----
# production | test。**默认 production** —— 生产服务器的 .env 不加这一项也不受影响。
# 设成任何非 production 的值会产生两个效果：
#   1) Superset 标题显示 [TEST]，避免把测试看板当生产看
#   2) ⚠️ **强制关闭对外发信** —— mail-service 即使 MAIL_SERVICE_DRY_RUN=false 也不发。
#      测试机跑的是同一套真实邮箱凭据，这道锁是为了让「测试环境给真实客户发信」
#      在结构上不可能发生，而不是靠记得改一个开关。
CHANNELHUB_ENV=production

# ---- PostgreSQL（主业务库 + prefect/superset 支撑库同实例）----
POSTGRES_USER=channelhub
POSTGRES_PASSWORD=change-me-or-auto-generated
POSTGRES_DB=channelhub
POSTGRES_PORT=5432

# ---- pgAdmin（数据库可视化）----
PGADMIN_DEFAULT_EMAIL=admin@channelhub.com
PGADMIN_DEFAULT_PASSWORD=change-me-or-auto-generated
PGADMIN_PORT=5050

# ---- MinIO（邮件源文件备份对象存储）----
MINIO_ROOT_USER=channelhub
MINIO_ROOT_PASSWORD=change-me-or-auto-generated
MINIO_BUCKET=email-archive
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---- Superset（主对外 BI 工具,经 Caddy 443 公网暴露）----
# SECRET_KEY 用 openssl rand -hex 32 生成,改了之后所有 session/cache 失效
SUPERSET_SECRET_KEY=change-me-or-auto-generated
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_EMAIL=admin@channelhub.com
SUPERSET_ADMIN_PASSWORD=change-me-or-auto-generated
SUPERSET_PORT=8088
# 端口绑定地址:默认 127.0.0.1(仅本机;服务器经 Caddy HTTPS 对外,保持默认)。
# 本机想局域网可见 → 设 0.0.0.0。⚠️ 服务器上别设 0.0.0.0(会裸暴露 8088、绕过 HTTPS)。
SUPERSET_BIND=127.0.0.1

# ---- Prefect 3 OSS（任务编排，复用上面的 POSTGRES_USER/PASSWORD）----
PREFECT_PORT=4200
# Caddy 对外暴露 Superset 的公网域名。变量名是历史遗留,语义=反代 host。
# 例如: data.ai-sunrise.de
PREFECT_PROXY_HOST=data.ai-sunrise.de
PREFECT_HTTP_PORT=80
PREFECT_HTTPS_PORT=443

# ---- 邮箱备份 IONOS IMAP（用户名=完整邮箱地址，例 name@yourdomain.com）----
# EMAIL_USER / EMAIL_PASSWORD 必填：邮箱地址 + 该邮箱密码（非 IONOS 账户登录密码）
# 德区(.de域名)账户用 imap.ionos.de；国际账户用 imap.ionos.com
EMAIL_HOST=imap.ionos.de
EMAIL_PORT=993
EMAIL_USER=
EMAIL_PASSWORD=
# 备份的文件夹，逗号分隔，默认仅 INBOX
EMAIL_FOLDERS=INBOX
# MinIO 内对象键前缀
EMAIL_BACKUP_PREFIX=email
# 备份频率 cron（UTC）。本 flow 很轻（实测约 3 秒），且只在真收到新邮件时才触发
# 下游解析/回信，所以可以跑高频；每 5 分钟 = 回信最长延迟 5 分钟
EMAIL_BACKUP_CRON=*/5 * * * *
# 解析 ETL 的**每日兜底**补跑 cron（UTC）。正常路径是 email-backup 收到新邮件时
# 触发；这条只为补上偶发失败。该 flow 全量重扫归档（实测 136 秒），别调高频
EMAIL_PARSE_CRON=0 3 * * *
# worker 在 docker 网络内访问 MinIO 的地址
EMAIL_BACKUP_MINIO_ENDPOINT=minio:9000

# ---- SMTP 发信（解析 ETL 未识别附件告警用；用户名=完整邮箱地址）----
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# ---- 未识别报表附件告警收件人 ----
ALERT_EMAIL_TO=

# ---- 邮件服务 flow（收信 → 处理 → 回信，flows/mail_service.py）----
# true = 照常生成附件、照常记账，但**不实际发信**（只打日志）。
# 首次上线务必先 true 验证，确认无误后再改 false 真正对外回信。
MAIL_SERVICE_DRY_RUN=true

# ---- WireGuard VPN（wg-easy；远程设备走服务器固定 IP 出网）----
# 写进客户端配置的 Endpoint。本服务器公网 IP 固定，直接填 IP 即可；
# 也可以在 IONOS DNS 加一条 A 记录（例 vpn.ai-sunrise.de）再填域名。
WG_HOST=82.165.180.145
# 管理 UI 的登录账号密码（密码建议 openssl rand -hex 24）。
# ⚠️ 只在**首次启动**时生效：wg_easy_data 卷一旦建好，改这里不再有任何影响，
#    要改密码请进管理 UI 改。
WG_ADMIN_USERNAME=admin
WG_ADMIN_PASSWORD=change-me-or-auto-generated
# 隧道 UDP 端口。改了要同步改 IONOS Cloud Panel 防火墙放行规则
WG_PORT=51820
# 客户端连上 VPN 后用的 DNS。1.1.1.1=Cloudflare，9.9.9.9=Quad9
WG_DNS=1.1.1.1
# VPN 内网段，每台客户端从这里分一个地址
WG_IPV4_CIDR=10.8.0.0/24
# 客户端把哪些目标路由进隧道。
# 0.0.0.0/0 = full tunnel（全部上网流量走服务器出口，这是固定 IP 的用法）
# 只想访问服务器内部服务 → 改成 172.18.0.0/16, 10.8.0.0/24
WG_ALLOWED_IPS=0.0.0.0/0
# 管理 UI 绑定地址与端口。默认仅本机，远程管理走 SSH 隧道：
#   ssh -N -L 51821:localhost:51821 deploy@82.165.180.145
# ⚠️ 别改成 0.0.0.0：UI 是明文 HTTP，暴露出去等于把 VPN 控制台裸放公网。
WG_UI_BIND=127.0.0.1
WG_UI_PORT=51821
WG_INSECURE=true

# ---- BI 只读角色（Superset 连库用；密码建议 openssl rand -hex 24）----
BI_READONLY_USER=bi_readonly
BI_READONLY_PASSWORD=change-me-or-auto-generated

# ---- 竞品情报采集 CI（竞品/自家擦窗机的价格、口碑、讨论、媒体）----
# 干跑开关：true=照常抓取解析但**不写库、不存 MinIO**。首次上线务必先 true 跑一轮，
# 确认抓到、解析对、型号匹配对，再改 false。（缺键时代码侧默认 true，宁可空跑不误写）
CI_DRY_RUN=true
# 价格+商品页指标，日频（UTC）。日粒度时间序列是本项目的产出，不需要更高频；
# 提频只增加被封风险。05:00 UTC 避开德国白天流量高峰。
CI_PRICE_CRON=0 5 * * *
# 讨论层日频（UTC）。与价格错开 30 分钟，避免同时打同一批站点。
CI_SOCIAL_CRON=30 5 * * *
# 媒体层周频（UTC，周一）。该品类德语评测总量极小，日频只会反复抓到同一批文章。
CI_MEDIA_CRON=0 6 * * 1
# 每域最小请求间隔（秒）。总量本就小，慢一点换稳定得多。
CI_MIN_INTERVAL_SEC=2.5
# 抓取原样存档桶（与 email-archive 并列）。页面改版后靠它回溯重跑解析器。
CI_MINIO_BUCKET=ci-archive
# 放进 User-Agent 的联系邮箱（礼貌抓取的基本要求）。留空则回落到 ALERT_EMAIL_TO。
CI_CONTACT_EMAIL=
# ⚠️ 作者身份加盐（GDPR）：评论作者名只以 salt+名 的哈希入库，绝不落显示名。
#    一旦开跑**不要再改**——改了等于历史哈希全部对不上。openssl rand -hex 24
CI_AUTHOR_SALT=change-me-or-auto-generated
# Amazon 采集开关：被封时可一键停掉而不影响其余源。
# 只抓 /dp/{ASIN} 与 /product-reviews/{ASIN}（均不在 amazon.de robots.txt 的
# User-agent:* Disallow 内），搜索页 /s? 代码侧硬性禁用。
CI_AMAZON_ENABLED=true
# eBay Browse API（免费，developer.ebay.com 建应用取 client id/secret）。留空则跳过该源。
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# YouTube Data API v3（免费 10k units/天，Google Cloud Console 建 API key）。留空则跳过。
YOUTUBE_API_KEY=
# Reddit OAuth（免费，reddit.com/prefs/apps 建 "script" 应用）。留空则跳过。
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# 媒体层额外直连 feed（逗号分隔）。默认走 Google News RSS 统一发现，
# 想直连某家 feed 时在这里加，无需改代码。
CI_MEDIA_EXTRA_FEEDS=
# mydealz 要轮询的分组 feed（逗号分隔的 slug，对应 /rss/gruppe/<slug>）。
# 走公开 RSS，**不需要 Pepper REST 的应用签名**。ecovacs 是品牌分组，命中率最高。
# 留空则用默认 ecovacs,saugroboter,haushaltsgeraete。
CI_MYDEALZ_GROUPS=

# ---- Instagram Hashtag Search ----
# ⚠️ 这条线的准入是本项目最重的：需要 IG Business/Creator 账号 + 绑定 FB 主页 +
#    应用通过 App Review 拿到 `Instagram Public Content Access` feature 与
#    `instagram_basic` 权限。审核要提交用例说明和录屏，周期通常几周。
#    两个值任一留空即跳过该源，不影响其它源。
#
# 三条**结构性**限制，配观察清单前必须知道（详见 docs/COMPETITIVE_INTEL.md）：
#   1) 只能按 hashtag 检索，**没有自由文本搜索**；
#   2) recent_media 只返回查询时刻前 **24 小时**内发布的贴文，补不了历史；
#   3) **拿不到作者**（username 字段不可请求），故 author_hash 恒为空。
INSTAGRAM_ACCESS_TOKEN=
# IG Business 账号的数字 id（不是用户名）。Graph API Explorer 里
# GET /me/accounts?fields=instagram_business_account 可取到。
INSTAGRAM_IG_USER_ID=
# Graph API 版本。Meta 每个版本约两年生命周期，到期前要升。
INSTAGRAM_GRAPH_VERSION=v26.0
# hashtag 配额预算。Meta 限每账号 7 天滚动窗口内 30 个不同 hashtag，
# 这里默认 26 是**故意留 4 个余量**：真实账本在 Meta 那边，你在 Graph API
# Explorer 里手工试的词也算进那 30 个，本地记账只是保守镜像。
# 观察清单本身在 core.ci_hashtag 表（改词是运维动作，不必重新部署）。
CI_INSTAGRAM_HASHTAG_BUDGET=26

# ---- LLM 情报简报（ci_digest.py）----
# 把一周的 raw.ci_mention 交给 Claude 出一份中文简报，写入 mart.ci_digest。
# 留空则该 flow 会失败告警（不是静默跳过——简报缺失应该被看见）。
# console.anthropic.com 取 key。
ANTHROPIC_API_KEY=
# 简报排期（UTC，周一）。**必须晚于 CI_MEDIA_CRON**，否则漏掉当周媒体评测。
CI_DIGEST_CRON=0 7 * * 1
# 回看天数。默认 7 与周频排期一致；改成 1 + 日频 cron 就是每日简报。
CI_DIGEST_WINDOW_DAYS=7
# 输入规模上限。超了**显式失败**而不是截断——基于部分数据写出的简报
# 和完整简报长得一模一样，没人能从结果里看出被砍过。
CI_DIGEST_MAX_INPUT_TOKENS=400000
