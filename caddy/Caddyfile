# Caddy 反向代理：把内部 Metabase 经 HTTPS 暴露到公网 443
#
# 历史: 这里最初是给 Prefect UI 套 HTTPS(解决 crypto.randomUUID
# 白屏问题);现 Prefect 改走 SSH 隧道,Caddy 改服务 Metabase。
# PREFECT_PROXY_HOST 变量名保留,语义是"Caddy 对外暴露的 host(IP/域名)"
# — 同时写进自签证书 SAN。

{
	# 只用内置自签 CA 颁发本地证书；绝不联网向 ACME / Let's Encrypt 申请
	auto_https disable_redirects
	# 客户端连 IP 时按 RFC 不发 SNI；用此值兜底选证书+匹配站点，
	# 否则浏览器/curl 访问 https://<IP> 会握手报 tlsv1 internal error
	default_sni {$PREFECT_PROXY_HOST}
}

https://{$PREFECT_PROXY_HOST} {
	tls internal
	# 反代 Metabase 容器（同 docker 网络,主机名 metabase,容器内端口 3000）
	reverse_proxy metabase:3000
}
